{
  "manifest_version": 3,
  "name": "YT Auto Timestamps",
  "version": "1.0",
  "description": "Triggers AI chat to load generate timestamps of the current video",
  "permissions": ["downloads", "storage"],
  "action": {
    "default_title": "YT Auto Timestamps settings",
    "default_popup": "settings.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["settings.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
